{
  "campaign": "fixed_point",
  "comment": "docs/notes2 tier T2: fixed32.16 at PE 32x8 (fixed16.8 is in dtype_same_array; 8-bit fixed crashes Vitis HLS csynth). DDR read taps tuned under load at bring-up (gemmflow.ddr_tune, misc/int32_verify).",
  "base": "configs/gemm/pe32x8_ta_t1024x512.json",
  "build_grid": {
    "@format": [
      {
        "kernel.data_type": "fixed",
        "kernel.data_bits": 32,
        "kernel.frac_bits": 16
      }
    ]
  },
  "runtime_grid": {
    "triples": [
      [
        2048,
        2048,
        2048
      ],
      [
        4096,
        4096,
        4096
      ],
      [
        8192,
        8192,
        8192
      ]
    ],
    "repetitions": 2,
    "warmup": 0,
    "verify": "sampled"
  },
  "stages": [
    "hls",
    "build",
    "run"
  ],
  "jobs": {
    "hls": "auto"
  },
  "ddr_load_tune": true
}
