{
  "campaign": "dtype_clock",
  "comment": "docs/notes2: clock headroom of the best verified int8 array from int8_scale (PE 32x32, tile 512x1024, 379 GOP/s at 200 MHz). 200 MHz default reuses that build.",
  "base": "configs/gemm/pe32x8_ta_t1024x512.json",
  "build_grid": {
    "@format": [
      {
        "kernel.data_type": "int",
        "kernel.data_bits": 8
      }
    ],
    "@array": [
      {
        "kernel.parallelism_n": 32,
        "kernel.parallelism_m": 32,
        "kernel.memory_tile_size_n": 512,
        "kernel.memory_tile_size_m": 1024
      }
    ],
    "clocks.accel_mhz": [
      200,
      225,
      250
    ],
    "vivado.preset": [
      "default",
      "aggressive"
    ]
  },
  "runtime_grid": {
    "triples": [
      [
        4096,
        4096,
        4096
      ],
      [
        8192,
        8192,
        8192
      ]
    ],
    "repetitions": 2,
    "warmup": 0,
    "verify": "sampled"
  },
  "stages": [
    "hls",
    "build",
    "run"
  ],
  "jobs": {
    "hls": "auto"
  }
}
