{
  "campaign": "int8_scale",
  "comment": "docs/notes2: highest int8 GOP/s with the DSP/BRAM freed by narrow lanes. Prune with dtype_hls before running.",
  "base": "configs/gemm/pe32x8_ta_t1024x512.json",
  "build_grid": {
    "@format": [
      {
        "kernel.data_type": "int",
        "kernel.data_bits": 8
      }
    ],
    "@array": [
      {
        "kernel.parallelism_n": 32,
        "kernel.parallelism_m": 16,
        "kernel.memory_tile_size_n": 512,
        "kernel.memory_tile_size_m": 1024
      },
      {
        "kernel.parallelism_n": 32,
        "kernel.parallelism_m": 32,
        "kernel.memory_tile_size_n": 512,
        "kernel.memory_tile_size_m": 1024
      },
      {
        "kernel.parallelism_n": 16,
        "kernel.parallelism_m": 64,
        "kernel.memory_tile_size_n": 256,
        "kernel.memory_tile_size_m": 1024
      },
      {
        "kernel.parallelism_n": 32,
        "kernel.parallelism_m": 64,
        "kernel.memory_tile_size_n": 512,
        "kernel.memory_tile_size_m": 2048
      }
    ],
    "kernel.mult_resource": [
      null,
      "fabric"
    ]
  },
  "runtime_grid": {
    "triples": [
      [
        2048,
        2048,
        2048
      ],
      [
        4096,
        4096,
        4096
      ],
      [
        8192,
        8192,
        8192
      ]
    ],
    "repetitions": 2,
    "warmup": 0,
    "verify": "sampled"
  },
  "stages": [
    "hls",
    "build",
    "run"
  ],
  "jobs": {
    "hls": "auto"
  }
}
